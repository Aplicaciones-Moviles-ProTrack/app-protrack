<?xml version="1.0" encoding="utf-8"?>
<!-- Define la estructura visual para fragment generar qr. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#0F1A25"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#00BCD4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Generar QR"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintBaseline_toBaselineOf="@id/btnBack"
                app:layout_constraintStart_toEndOf="@id/btnBack" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tvQrCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_badge_rounded_cyan"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:textColor="#00BCD4"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerContainer"
            tools:text="Pisos y Revestimientos" />

        <TextView
            android:id="@+id/tvQrNombreProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="24dp"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"
            android:textColor="#212121"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvQrCategoria"
            tools:text="Porcelanato Pulido Ártico 60x60" />

        <LinearLayout
            android:id="@+id/lyIdRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvQrNombreProducto">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#616161"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvQrIdProducto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#616161"
                android:textSize="15sp"
                tools:text="PRT-9920-X1" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQrArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginHorizontal="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lyIdRow">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <View
                    android:id="@+id/viewDottedFrame"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_dotted_rect"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/statusBadge"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginBottom="20dp"/>

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_qr_corner_bracket"
                    app:layout_constraintTop_toTopOf="@id/viewDottedFrame"
                    app:layout_constraintStart_toStartOf="@id/viewDottedFrame"
                    android:rotation="0" />
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_qr_corner_bracket"
                    app:layout_constraintTop_toTopOf="@id/viewDottedFrame"
                    app:layout_constraintEnd_toEndOf="@id/viewDottedFrame"
                    android:rotation="90" />
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_qr_corner_bracket"
                    app:layout_constraintBottom_toBottomOf="@id/viewDottedFrame"
                    app:layout_constraintEnd_toEndOf="@id/viewDottedFrame"
                    android:rotation="180" />
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_qr_corner_bracket"
                    app:layout_constraintBottom_toBottomOf="@id/viewDottedFrame"
                    app:layout_constraintStart_toStartOf="@id/viewDottedFrame"
                    android:rotation="270" />

                <ImageView
                    android:id="@+id/ivCodigoQrReal"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="35dp"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="@id/viewDottedFrame"
                    app:layout_constraintEnd_toEndOf="@id/viewDottedFrame"
                    app:layout_constraintStart_toStartOf="@id/viewDottedFrame"
                    app:layout_constraintTop_toTopOf="@id/viewDottedFrame"
                    tools:src="@tools:sample/backgrounds/scenic" />

                <LinearLayout
                    android:id="@+id/statusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_badge_grey"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:gravity="center_vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/stat_notify_sync"
                        app:tint="#00BCD4"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROTRACK ID VERIFIED"
                        android:textColor="#616161"
                        android:textStyle="bold"
                        android:textSize="10sp"/>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/lyActionsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginHorizontal="24dp"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardQrArea">

            <LinearLayout
                android:id="@+id/btnImprimir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_button_white_rounded_stroke">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_add"
                    app:tint="#212121" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Imprimir"
                    android:textSize="12sp"
                    android:textColor="#616161"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnGuardar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_button_cyan_fully_rounded">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/stat_sys_download"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Guardar"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnCompartir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_button_white_rounded_stroke">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_share"
                    app:tint="#212121" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Compartir"
                    android:textSize="12sp"
                    android:textColor="#616161"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_note_grey_rounded"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lyActionsRow">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#616161"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="#616161"
                android:text="Nota: El QR es único e irrepetible y está vinculado estrictamente al ID del producto dentro del sistema ProTrack. Asegúrese de que la impresión sea de alta calidad para garantizar una lectura correcta en almacén."/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>