<?xml version="1.0" encoding="utf-8"?>
<!-- Define la estructura visual para item historial proforma. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvNumeroLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/numero_proforma"
                android:textColor="#757575"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvHistorialNumero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#121B22"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvNumeroLabel"
                tools:text="PF-2026-001" />

            <TextView
                android:id="@+id/tvHistorialEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_rounded_cyan"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#121B22"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Enviada" />

            <ImageView
                android:id="@+id/ivClienteProforma"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_badge_rounded_cyan"
                android:contentDescription="@string/cliente"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHistorialNumero"
                app:tint="#121B22" />

            <TextView
                android:id="@+id/tvHistorialCliente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#212121"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivClienteProforma"
                app:layout_constraintTop_toTopOf="@id/ivClienteProforma"
                tools:text="Distribuidora Continental S.A." />

            <TextView
                android:id="@+id/tvHistorialFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:drawablePadding="5dp"
                android:textColor="#757575"
                android:textSize="12sp"
                app:drawableStartCompat="@android:drawable/ic_menu_my_calendar"
                app:layout_constraintStart_toEndOf="@id/ivClienteProforma"
                app:layout_constraintTop_toBottomOf="@id/tvHistorialCliente"
                tools:text="24 oct 2026" />

            <View
                android:id="@+id/dividerTotal"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="#E0E0E0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivClienteProforma" />

            <TextView
                android:id="@+id/tvTotalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/total_proforma"
                android:textColor="#757575"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dividerTotal" />

            <TextView
                android:id="@+id/tvHistorialTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00BCD4"
                android:textSize="19sp"
                android:textStyle="bold"
                app:layout_constraintBaseline_toBaselineOf="@id/tvTotalLabel"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="S/. 1,250.75" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistorialVer"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/ver"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_view"
                app:iconGravity="textStart"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistorialEnviar"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/enviar"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_send"
                app:iconGravity="textStart"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistorialPdf"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/pdf"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="textStart"
                app:iconSize="16dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>