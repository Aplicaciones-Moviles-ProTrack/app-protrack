<?xml version="1.0" encoding="utf-8"?>
<!-- Define la estructura visual para item alerta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@android:color/white"
    android:padding="8dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/stat_sys_warning"
        app:tint="#F44336"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreAlerta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            tools:text="Porcelanato Gris 60x60" />

        <TextView
            android:id="@+id/tvCategoriaAlerta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#757575"
            tools:text="Pisos y Revestimientos" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStockAlerta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F44336"
        android:textStyle="bold"
        android:textSize="12sp"
        android:gravity="end"
        tools:text="4 unidades\nCrítico" />
</LinearLayout>